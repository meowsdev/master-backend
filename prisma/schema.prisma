generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  COUNSELOR
  TECHNICIAN
  ADMIN
  HR
  MANAGER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  /// Blocked by staff for now; can be unblocked.
  SUSPENDED
  /// Banned by an admin; only an admin can lift it.
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  OFFER
  SYSTEM
}

enum ChatTabCategory {
  SERVICE
  ORDER
  SUPPORT
}

enum ChatFlowType {
  CUSTOMER_PROVIDER
  CUSTOMER_COUNSELOR
  CUSTOMER_SUPPORT
}

enum ChatSlotStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum PaymentMode {
  CASH
  /// Provider asked for online payment; the customer has not chosen bKash / Nagad / card yet.
  ONLINE
  BKASH
  NAGAD
  CARD
  BANK
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DISPUTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum ProviderLevel {
  NEW
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RevisionStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum AuditFlowType {
  CHAT
  ORDER
  PAYMENT
  SYSTEM
}

enum CounselorActionType {
  ASSIGNED
  REASSIGNED
  CLOSED
  NOTE_ADDED
}

model User {
  id           String     @id @default(uuid())
  mobileNumber String     @unique @db.VarChar(15)
  otp          String?    @db.VarChar(8)
  otpExpire    DateTime?
  name         String?    @db.VarChar(100)
  username     String?    @unique @db.VarChar(30)
  // Ids from the Bangladesh locations reference data (see LocationsService)
  districtId   Int?
  upazilaId    Int?
  email        String?    @unique
  dateOfBirth  DateTime?  @db.Date
  profilePhoto String?    @db.VarChar(255)
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(INACTIVE)
  isVerified   Boolean    @default(false)
  /// Set by staff: a restricted provider gets no new orders, a restricted customer cannot place any.
  isRestricted Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses             UserAddress[]
  counselorProfile      CounselorProfile?
  customerProfile       CustomerProfile?
  providerProfile       ProviderProfile?
  technicianProfile     TechnicianProfile?
  refreshTokens         RefreshToken[]
  serviceAssignments    ServiceAssignee[]
  chatParticipants      ChatParticipant[]
  sentMessages          Message[]            @relation("SentMessages")
  extraChargeRequests   ExtraChargeRequest[] @relation("ExtraChargeRequester")
  sentChatAuditLogs     ChatAuditLog[]       @relation("ChatAuditSender")
  customerChatSessions  ChatSession[]        @relation("ChatSessionCustomer")
  counselorChatSessions ChatSession[]        @relation("ChatSessionCounselor")
  providerChatSessions  ChatSession[]        @relation("ChatSessionProvider")
  supportThread         SupportThread?       @relation("SupportThreadMember")
  sentSupportMessages   SupportMessage[]     @relation("SupportMessageSender")
  moderationLog         UserModerationLog[]  @relation("ModeratedUser")
  moderationsDone       UserModerationLog[]  @relation("ModerationActor")
  orderAssignmentsDone  OrderAssignmentLog[] @relation("OrderAssignmentActor")

  @@index([mobileNumber, name])
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String
  addressText String   @db.Text
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  address     String?
  gender      Gender?
  dateOfBirth DateTime? @db.Date
  /// Average of the ratings providers gave this customer (CustomerRating); 0 until the first one.
  rating      Decimal   @default(0.0) @db.Decimal(3, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerRatings    CustomerRating[]
  chatSessions       ChatSession[]       @relation("CustomerProfileChatSessions")
  activeChatSlots    ActiveChatSlot[]
  orders             Order[]
  providerReviews    ProviderReview[]
  customerRetentions CustomerRetention[]
}

model ProviderProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  bio                  String?
  rating               Decimal       @default(0.0) @db.Decimal(3, 2)
  /// Shown to customers in order tabs; has priority over the username.
  companyName          String?       @db.VarChar(120)
  totalCompletedOrders Int           @default(0)
  level                ProviderLevel @default(NEW)
  experienceYears      Int           @default(0)
  isAvailable          Boolean       @default(true)
  monthlyEarnings      Decimal       @default(0.0) @db.Decimal(10, 2)
  walletBalance        Decimal       @default(0.0) @db.Decimal(10, 2)
  isBlockedForNegative Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc                 ProviderKyc?
  technicianProfiles  TechnicianProfile[]   @relation("ProviderAgencyTechnicians")
  activeChatSlots     ActiveChatSlot[]
  orders              Order[]
  orderOffers         OrderOffer[]
  serviceAreas        ProviderServiceArea[]
  assignmentsReceived OrderAssignmentLog[]
  providerReviews     ProviderReview[]
  customerRetentions  CustomerRetention[]
}

model CounselorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  activeChatCount    Int      @default(0)
  isOnline           Boolean  @default(false)
  maxConcurrentLimit Int      @default(0)
  avgResponseTimeSec Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs CounselorAuditLog[]
}

model TechnicianProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  providerAgencyId String?
  lastLoginAt      DateTime?
  invitedAt        DateTime?
  currentLat       Decimal?  @db.Decimal(10, 8)
  currentLong      Decimal?  @db.Decimal(11, 8)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAgency ProviderProfile? @relation("ProviderAgencyTechnicians", fields: [providerAgencyId], references: [id], onDelete: SetNull)
  orders         Order[]

  @@index([providerAgencyId])
}

model ProviderKyc {
  id             String    @id @default(uuid())
  providerId     String    @unique
  nidNumber      String?   @db.VarChar(30)
  tradeLicenseNo String?   @db.VarChar(40)
  status         KycStatus @default(PENDING)
  nidFrontUrl    String?   @db.VarChar(255)
  nidBackUrl     String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// One row per phone number: holds the live OTP (hash only) plus the send
// counters that enforce the resend cooldown and daily cap.
model OtpRequest {
  id               String    @id @default(uuid())
  phoneNumber      String    @unique @db.VarChar(20)
  codeHash         String?
  expiresAt        DateTime?
  attempts         Int       @default(0)
  // Set when the OTP was used, or killed by too many wrong attempts.
  consumedAt       DateTime?
  lastSentAt       DateTime
  dailyWindowStart DateTime
  dailySendCount   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  // Groups every rotation of one login; revoking the family ends that session.
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model ServiceCategory {
  id               String    @id @default(uuid())
  name             String    @unique @db.VarChar(100)
  slug             String    @unique
  description      String?
  iconUrl          String?   @db.VarChar(255)
  isFixedPrice     Boolean   @default(false)
  basePrice        Decimal   @default(0.0) @db.Decimal(10, 2)
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  icon             String?   @db.VarChar(16)
  shortDescription String?   @db.VarChar(160)
  isPopular        Boolean   @default(false)
  sortOrder        Int       @default(0)
  deletedAt        DateTime?

  services     Service[]
  questions    ServiceQuestion[]
  chatSessions ChatSession[]

  @@index([sortOrder])
}

model Service {
  id           String    @id @default(uuid())
  categoryId   String
  name         String    @db.VarChar(100)
  // Shown on the public service page (hero image, Bengali title, feature list)
  nameBn       String?   @db.VarChar(150)
  imageUrl     String?   @db.VarChar(500)
  features     String[]  @default([])
  description  String?   @db.VarChar(255)
  isFixedPrice Boolean   @default(false)
  isPopular    Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  orderCount   Int       @default(0)
  basePrice    Decimal   @default(0.0) @db.Decimal(10, 2)
  durationMin  Int?
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  slug         String    @db.VarChar(120)
  /// FIXED = one price; PER_UNIT / PER_SQFT = the customer also picks a quantity.
  priceUnit    PriceUnit @default(FIXED)
  sortOrder    Int       @default(0)
  deletedAt    DateTime?

  category           ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chatSessions       ChatSession[]
  activeChatSlots    ActiveChatSlot[]
  orders             Order[]
  serviceAssignments ServiceAssignee[]
  orderItems         OrderItem[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isPopular])
}

model ServiceAssignee {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

model ChatSession {
  id                String          @id @default(uuid())
  customerId        String
  counselorId       String?
  providerId        String?
  customerProfileId String
  serviceId         String
  /// One chat per customer per main service; orders of that service are tabs inside it.
  categoryId        String
  tabCategory       ChatTabCategory @default(SERVICE)
  flowType          ChatFlowType    @default(CUSTOMER_PROVIDER)
  assignedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerUser       User                @relation("ChatSessionCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  counselorUser      User?               @relation("ChatSessionCounselor", fields: [counselorId], references: [id], onDelete: SetNull)
  providerUser       User?               @relation("ChatSessionProvider", fields: [providerId], references: [id], onDelete: SetNull)
  customerProfile    CustomerProfile     @relation("CustomerProfileChatSessions", fields: [customerProfileId], references: [id], onDelete: Cascade)
  service            Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category           ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  participants       ChatParticipant[]
  messages           Message[]
  chatAuditLogs      ChatAuditLog[]
  counselorAuditLogs CounselorAuditLog[]

  @@unique([customerProfileId, categoryId])
  @@index([categoryId])
  @@index([customerId])
  @@index([counselorId])
  @@index([providerId])
  @@index([customerProfileId])
  @@index([serviceId])
}

model ChatParticipant {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  senderId  String
  text      String?     @db.Text
  fileUrl   String?
  type      MessageType @default(TEXT)
  isRead    Boolean     @default(false)
  isSend    Boolean     @default(false)
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  /// null = General Chat tab; otherwise the order tab the message belongs to.
  orderId   String?

  order   Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([senderId])
  @@index([orderId])
}

model ChatAuditLog {
  id             BigInt        @id @default(autoincrement())
  sessionId      String
  senderId       String?
  flowType       AuditFlowType
  messageType    MessageType?
  messagePayload Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User?       @relation("ChatAuditSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([senderId])
}

model ActiveChatSlot {
  id         String         @id @default(uuid())
  providerId String
  customerId String
  serviceId  String
  status     ChatSlotStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([customerId])
  @@index([serviceId])
}

model CustomerRetention {
  id            String   @id @default(uuid())
  providerId    String
  customerId    String
  isChatActive  Boolean  @default(true)
  removedReason String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([providerId, customerId])
  @@index([providerId])
  @@index([customerId])
}

model Order {
  id              String        @id @default(uuid())
  /// Customer-facing reference, e.g. A94K2B. Random, unique, never reused.
  referenceCode   String        @unique @db.VarChar(6)
  completedAt     DateTime?
  /// When a provider first took the order; the customer sees how long that took.
  acceptedAt      DateTime?
  providerId      String
  customerId      String
  technicianId    String?
  serviceId       String
  originalPrice   Decimal       @db.Decimal(10, 2)
  adminCommission Decimal       @default(0.0) @db.Decimal(10, 2)
  additionalPrice Decimal       @default(0.0) @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  priceEditCount  Int           @default(0)
  advancePaid     Decimal       @default(0.0) @db.Decimal(10, 2)
  dueAmount       Decimal       @default(0.0) @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(UNPAID)
  orderStatus     OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  provider        ProviderProfile       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  customer        CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician      TechnicianProfile?    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  service         Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  paymentAndTip   OrderPaymentAndTip?
  revisions       ServiceRevision[]
  providerReview  ProviderReview?
  bookingDetail   OrderBookingDetail?
  items           OrderItem[]
  messages        Message[]
  extraCharges    ExtraChargeRequest[]
  customerRating  CustomerRating?
  advancePayments OrderAdvancePayment[]
  offers          OrderOffer[]
  assignmentLog   OrderAssignmentLog[]

  @@index([providerId])
  @@index([customerId])
  @@index([technicianId])
  @@index([serviceId])
}

model OrderPaymentAndTip {
  id                   String             @id @default(uuid())
  orderId              String             @unique
  paymentMode          PaymentMode
  serviceAmountPaid    Decimal            @default(0.0) @db.Decimal(10, 2)
  tipAmount            Decimal            @default(0.0) @db.Decimal(10, 2)
  hasTip               Boolean            @default(false)
  confirmationStatus   ConfirmationStatus @default(PENDING)
  confirmationDeadline DateTime?
  customerConfirmedAt  DateTime?
  disputeReason        String?            @db.Text
  varianceFlag         Boolean            @default(false)
  isGuestOrder         Boolean            @default(false)
  completedByPartner   Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ServiceRevision {
  id                String         @id @default(uuid())
  orderId           String
  issueDescription  String         @db.Text
  attachedImages    String[]
  revisionStatus    RevisionStatus @default(REQUESTED)
  warrantyExpiresAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ProviderReview {
  id                   String           @id @default(uuid())
  orderId              String           @unique
  providerId           String
  customerId           String
  customerRating       Int
  providerRating       Int?
  reviewComment        String?          @db.Text
  continueWithProvider Boolean          @default(false)
  isPublic             Boolean          @default(true)
  moderationStatus     ModerationStatus @default(PENDING)
  status               UserStatus       @default(ACTIVE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([customerId])
}

model CounselorAuditLog {
  id          String              @id @default(uuid())
  counselorId String
  sessionId   String
  actionType  CounselorActionType
  remarks     String?             @db.VarChar(255)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  counselor CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  session   ChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([counselorId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Place-order catalog. Admins set every price and every "countable" flag here;
// the customer app only displays them and the backend computes the total.
// ---------------------------------------------------------------------------

/// Follow-up question shown after the customer picks a sub-service of this main service
/// (e.g. AC: "Is the outdoor unit hanging?"). Admins set the option prices.
model ServiceQuestion {
  id         String   @id @default(uuid())
  categoryId String
  text       String   @db.VarChar(255)
  textBn     String?  @db.VarChar(300)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ServiceCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  ServiceQuestionOption[]

  @@index([categoryId])
}

model ServiceQuestionOption {
  id          String  @id @default(uuid())
  questionId  String
  label       String  @db.VarChar(100)
  labelBn     String? @db.VarChar(150)
  /// Surcharge per counted unit; 0 for a plain "No".
  unitPrice   Decimal @default(0.0) @db.Decimal(10, 2)
  /// When true the customer says how many of the ordered units this applies to.
  isCountable Boolean @default(false)
  sortOrder   Int     @default(0)

  question ServiceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/// What the customer asked for, plus the price breakdown frozen at order time.
model OrderBookingDetail {
  id             String   @id @default(uuid())
  orderId        String   @unique
  subServiceId   String?
  subServiceName String   @db.VarChar(200)
  quantity       Int      @default(1)
  description    String?  @db.Text
  districtId     Int
  upazilaId      Int
  addressDetail  String   @db.VarChar(300)
  scheduledDate  DateTime @db.Date
  timeSlot       String   @db.VarChar(40)
  imageUrls      String[] @default([])
  /// [{ label, unitPrice, count, amount }] so later admin price edits never rewrite old orders.
  priceBreakdown Json
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PriceUnit {
  FIXED
  PER_SQFT
  PER_UNIT
}

/// One priced line of an order: a sub-service, how many, and the price frozen at order time.
model OrderItem {
  id                String    @id @default(uuid())
  orderId           String
  subServiceId      String
  nameSnapshot      String    @db.VarChar(100)
  unitPriceSnapshot Decimal   @db.Decimal(10, 2)
  priceUnitSnapshot PriceUnit @default(FIXED)
  quantity          Int       @default(1)
  lineTotal         Decimal   @db.Decimal(10, 2)
  durationSnapshot  Int?
  createdAt         DateTime  @default(now())

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subService Service @relation(fields: [subServiceId], references: [id])

  @@index([orderId])
  @@index([subServiceId])
}

enum ExtraChargeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Extra work found on site. Sits outside the order price until the customer approves it.
model ExtraChargeRequest {
  id             String            @id @default(uuid())
  orderId        String
  requestedById  String
  /// [{ label, amount }] frozen at request time.
  items          Json
  totalAmount    Decimal           @db.Decimal(10, 2)
  /// Order total when the request was made, so the card can show "previous + new = new total".
  previousTotal  Decimal           @db.Decimal(10, 2)
  status         ExtraChargeStatus @default(PENDING)
  respondedAt    DateTime?
  /// Set when the customer has never signed in to the app (e.g. an order an admin placed for them):
  /// still unanswered at this time, the request is approved automatically. Null = the customer answers.
  autoApproveAt  DateTime?
  /// True when the approval came from that timer, not from the customer.
  isAutoApproved Boolean           @default(false)
  createdAt      DateTime          @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ExtraChargeRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, autoApproveAt])
}

/// The provider's rating of the customer once an order is done. One per order, never edited.
model CustomerRating {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String
  ratedById  String
  rating     Int
  comment    String?  @db.VarChar(300)
  createdAt  DateTime @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Money the customer paid before the final settlement (before the work starts or in the middle of it).
/// The final payment is the order's due, so these amounts are already subtracted from it.
model OrderAdvancePayment {
  id             String      @id @default(uuid())
  orderId        String
  amount         Decimal     @db.Decimal(10, 2)
  method         PaymentMode
  transactionId  String
  /// The bill and what was still due right after this payment, so the receipt stays true if the bill changes later.
  totalAtPayment Decimal?    @db.Decimal(10, 2)
  dueAfter       Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

/// A new order offered to one provider. Several providers are offered the same order at once (a "wave");
/// the first to accept gets it and the rest are withdrawn. A wave nobody answers in time is followed by the next.
model OrderOffer {
  id          String      @id @default(uuid())
  orderId     String
  providerId  String
  wave        Int
  status      OfferStatus @default(OFFERED)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([orderId, providerId])
  @@index([orderId, status])
  @@index([providerId, status])
}

/// The one direct chat between the platform staff (admin, manager, support) and a provider or a customer.
/// Staff share it, so any of them continues the same history. Unlike ChatSession it needs no service or order.
model SupportThread {
  id               String    @id @default(uuid())
  memberId         String    @unique
  /// Messages the member wrote after this moment are unread for staff, and the other way round.
  lastStaffReadAt  DateTime?
  lastMemberReadAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  member   User             @relation("SupportThreadMember", fields: [memberId], references: [id], onDelete: Cascade)
  messages SupportMessage[]
}

model SupportMessage {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  text      String   @db.Text
  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId])
}

/// An upazila where a provider takes orders. A new order is offered to the providers who cover its service
/// upazila first, then to those who cover its district. A provider with no area is offered nothing.
model ProviderServiceArea {
  id         String   @id @default(uuid())
  providerId String
  districtId Int
  upazilaId  Int
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, upazilaId])
  @@index([upazilaId])
  @@index([districtId])
}

/// Who restricted, blocked or banned whom, when and why. Never edited, only appended.
model UserModerationLog {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  action    String   @db.VarChar(20)
  reason    String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  user  User @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// An admin sent a not-yet-accepted order to one provider: OFFER (they may accept or decline) or ASSIGN (theirs at once).
model OrderAssignmentLog {
  id         String   @id @default(uuid())
  orderId    String
  actorId    String
  providerId String
  mode       String   @db.VarChar(10)
  createdAt  DateTime @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor    User            @relation("OrderAssignmentActor", fields: [actorId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

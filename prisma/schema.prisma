generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  COUNSELOR
  TECHNICIAN
  ADMIN
  HR
  MANAGER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  /// Blocked by staff for now; can be unblocked.
  SUSPENDED
  /// Banned by an admin; only an admin can lift it.
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  OFFER
  SYSTEM
}

enum ChatTabCategory {
  SERVICE
  ORDER
  SUPPORT
}

enum ChatFlowType {
  CUSTOMER_PROVIDER
  CUSTOMER_COUNSELOR
  CUSTOMER_SUPPORT
}

enum ChatSlotStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum PaymentMode {
  CASH
  /// Provider asked for online payment; the customer has not chosen bKash / Nagad / card yet.
  ONLINE
  BKASH
  NAGAD
  CARD
  BANK
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DISPUTED
  EXPIRED
}

/// Who created an order. Every screen shows it as a tag.
enum OrderCreator {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

/// Level 0 -> Level 1 -> Level 2 -> Top Rated (rules in provider-leveling/level-rules.ts, targets in LevelSetting).
enum ProviderLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  TOP_RATED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RevisionStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum AuditFlowType {
  CHAT
  ORDER
  PAYMENT
  SYSTEM
}

enum CounselorActionType {
  ASSIGNED
  REASSIGNED
  CLOSED
  NOTE_ADDED
}

model User {
  id           String     @id @default(uuid())
  mobileNumber String     @unique @db.VarChar(15)
  otp          String?    @db.VarChar(8)
  otpExpire    DateTime?
  name         String?    @db.VarChar(100)
  username     String?    @unique @db.VarChar(30)
  // Ids from the Bangladesh locations reference data (see LocationsService)
  districtId   Int?
  upazilaId    Int?
  email        String?    @unique
  dateOfBirth  DateTime?  @db.Date
  profilePhoto String?    @db.VarChar(255)
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(INACTIVE)
  isVerified   Boolean    @default(false)
  /// Set by staff: a restricted provider gets no new orders, a restricted customer cannot place any.
  isRestricted Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses              UserAddress[]
  counselorProfile       CounselorProfile?
  customerProfile        CustomerProfile?
  providerProfile        ProviderProfile?
  technicianProfile      TechnicianProfile?
  refreshTokens          RefreshToken[]
  serviceAssignments     ServiceAssignee[]
  chatParticipants       ChatParticipant[]
  sentMessages           Message[]            @relation("SentMessages")
  extraChargeRequests    ExtraChargeRequest[] @relation("ExtraChargeRequester")
  orderQuotes            OrderQuote[]         @relation("OrderQuoteRequester")
  expenseClaimsSubmitted OrderExpenseClaim[]  @relation("ExpenseClaimSubmitter")
  expenseClaimsReviewed  OrderExpenseClaim[]  @relation("ExpenseClaimReviewer")
  sentChatAuditLogs      ChatAuditLog[]       @relation("ChatAuditSender")
  customerChatSessions   ChatSession[]        @relation("ChatSessionCustomer")
  counselorChatSessions  ChatSession[]        @relation("ChatSessionCounselor")
  providerChatSessions   ChatSession[]        @relation("ChatSessionProvider")
  supportThread          SupportThread?       @relation("SupportThreadMember")
  sentSupportMessages    SupportMessage[]     @relation("SupportMessageSender")
  moderationLog          UserModerationLog[]  @relation("ModeratedUser")
  moderationsDone        UserModerationLog[]  @relation("ModerationActor")
  orderAssignmentsDone   OrderAssignmentLog[] @relation("OrderAssignmentActor")
  ordersCreated          Order[]              @relation("OrderCreatedBy")

  @@index([mobileNumber, name])
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String
  addressText String   @db.Text
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  address     String?
  gender      Gender?
  dateOfBirth DateTime? @db.Date
  /// Average of the ratings providers gave this customer (CustomerRating); 0 until the first one.
  rating      Decimal   @default(0.0) @db.Decimal(3, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerRatings    CustomerRating[]
  chatSessions       ChatSession[]       @relation("CustomerProfileChatSessions")
  activeChatSlots    ActiveChatSlot[]
  orders             Order[]
  providerReviews    ProviderReview[]
  customerRetentions CustomerRetention[]
}

model ProviderProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  bio                  String?
  rating               Decimal       @default(0.0) @db.Decimal(3, 2)
  /// Shown to customers in order tabs; has priority over the username.
  companyName          String?       @db.VarChar(120)
  totalCompletedOrders Int           @default(0)
  level                ProviderLevel @default(LEVEL_0)
  /// Set by an admin: the monthly evaluation leaves this provider's level as it is.
  isLevelLocked        Boolean       @default(false)
  /// Why the admin set the level by hand (shown to the provider).
  levelLockReason      String?       @db.VarChar(300)
  experienceYears      Int           @default(0)
  /// Providers who were working before KYC was required may still get orders until this moment without an
  /// approved KYC. Null (every new provider): no orders until the KYC is approved.
  kycGraceUntil        DateTime?
  isAvailable          Boolean       @default(true)
  monthlyEarnings      Decimal       @default(0.0) @db.Decimal(10, 2)
  walletBalance        Decimal       @default(0.0) @db.Decimal(10, 2)
  /// The platform's share of this provider's jobs, in percent (10 = 10%). An admin sets it per provider.
  commissionRate       Decimal       @default(10.0) @db.Decimal(5, 2)
  isBlockedForNegative Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc                 ProviderKyc?
  technicianProfiles  TechnicianProfile[]   @relation("ProviderAgencyTechnicians")
  activeChatSlots     ActiveChatSlot[]
  orders              Order[]
  orderOffers         OrderOffer[]
  serviceAreas        ProviderServiceArea[]
  assignmentsReceived OrderAssignmentLog[]
  providerReviews     ProviderReview[]
  customerRetentions  CustomerRetention[]
  walletCredits       WalletCredit[]
  withdrawalRequests  WithdrawalRequest[]
  dueReminders        DueReminder[]
  dispatchStats       ProviderDispatchStats?
}

model CounselorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  activeChatCount    Int      @default(0)
  isOnline           Boolean  @default(false)
  maxConcurrentLimit Int      @default(0)
  avgResponseTimeSec Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs CounselorAuditLog[]
}

model TechnicianProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  providerAgencyId String?
  lastLoginAt      DateTime?
  invitedAt        DateTime?
  currentLat       Decimal?  @db.Decimal(10, 8)
  currentLong      Decimal?  @db.Decimal(11, 8)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAgency ProviderProfile? @relation("ProviderAgencyTechnicians", fields: [providerAgencyId], references: [id], onDelete: SetNull)
  orders         Order[]

  @@index([providerAgencyId])
}

/// A provider's identity check. PENDING once sent, until an admin approves or rejects it (with a reason).
/// The NID pictures and the photo are private files (keys, not public URLs): only the provider and staff see them.
model ProviderKyc {
  id                String    @id @default(uuid())
  providerId        String    @unique
  fullName          String?   @db.VarChar(100)
  fatherName        String?   @db.VarChar(100)
  motherName        String?   @db.VarChar(100)
  /// MALE, FEMALE or OTHER.
  gender            String?   @db.VarChar(10)
  /// The number to reach the provider on (starts as their login number), as +8801XXXXXXXXX.
  contactPhone      String?   @db.VarChar(20)
  /// The address on the NID (not where they work: that is their service areas).
  districtId        Int?
  upazilaId         Int?
  postCode          String?   @db.VarChar(4)
  addressDetail     String?   @db.VarChar(300)
  nidNumber         String?   @db.VarChar(30)
  tradeLicenseNo    String?   @db.VarChar(40)
  status            KycStatus @default(PENDING)
  /// Old public URLs (unused) or private file keys from POST /provider-kyc/me/documents.
  nidFrontUrl       String?   @db.VarChar(255)
  nidBackUrl        String?   @db.VarChar(255)
  selfieUrl         String?   @db.VarChar(255)
  /// 2-3 family members to call when the provider cannot be reached: [{ name, relation, phone }].
  emergencyContacts Json      @default("[]")
  submittedAt       DateTime?
  /// When the provider accepted the provider terms (conduct and liability) on sending, and which version of them.
  termsAcceptedAt   DateTime?
  termsVersion      String?   @db.VarChar(40)
  reviewedAt        DateTime?
  reviewedById      String?
  /// Why an admin rejected it, shown to the provider so they can fix and send again.
  rejectReason      String?   @db.VarChar(300)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// One row per phone number: holds the live OTP (hash only) plus the send
// counters that enforce the resend cooldown and daily cap.
model OtpRequest {
  id               String    @id @default(uuid())
  phoneNumber      String    @unique @db.VarChar(20)
  codeHash         String?
  expiresAt        DateTime?
  attempts         Int       @default(0)
  // Set when the OTP was used, or killed by too many wrong attempts.
  consumedAt       DateTime?
  lastSentAt       DateTime
  dailyWindowStart DateTime
  dailySendCount   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  // Groups every rotation of one login; revoking the family ends that session.
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Level 2 of the catalog, the MAIN SERVICE (e.g. "AC Servicing"). One chat per customer per main service;
/// its orders are tabs inside that chat. Belongs to a ServiceGroup (level 1, the top-bar category).
model ServiceCategory {
  id               String    @id @default(uuid())
  groupId          String?
  imageUrl         String?   @db.VarChar(500)
  /// Overview tab defaults for every sub-service of this main service ("What's included / excluded").
  included         String[]  @default([])
  excluded         String[]  @default([])
  /// Long text for the Details tab; a sub-service's own details win over this.
  details          String?   @db.Text
  /// "How to order" steps; empty = the app's standard three steps.
  howToOrder       String[]  @default([])
  name             String    @unique @db.VarChar(100)
  slug             String    @unique
  description      String?
  iconUrl          String?   @db.VarChar(255)
  isFixedPrice     Boolean   @default(false)
  basePrice        Decimal   @default(0.0) @db.Decimal(10, 2)
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  icon             String?   @db.VarChar(16)
  shortDescription String?   @db.VarChar(160)
  isPopular        Boolean   @default(false)
  sortOrder        Int       @default(0)
  deletedAt        DateTime?

  group        ServiceGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  services     Service[]
  questions    ServiceQuestion[]
  chatSessions ChatSession[]
  faqs         ServiceFaq[]
  orders       Order[]

  @@index([sortOrder])
  @@index([groupId])
}

/// Level 1 of the catalog, the CATEGORY in the top bar (e.g. "AC Repair Services", "Cleaning Solution").
model ServiceGroup {
  id        String    @id @default(uuid())
  name      String    @unique @db.VarChar(100)
  nameBn    String?   @db.VarChar(150)
  slug      String    @unique @db.VarChar(120)
  iconUrl   String?   @db.VarChar(500)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categories ServiceCategory[]

  @@index([sortOrder])
}

/// Level 4 of the catalog: a priced option of a sub-service (e.g. "1 - 2.5 Ton"). The customer adds variants to the cart.
model ServiceVariant {
  id            String    @id @default(uuid())
  serviceId     String
  name          String    @db.VarChar(100)
  nameBn        String?   @db.VarChar(150)
  imageUrl      String?   @db.VarChar(500)
  price         Decimal   @db.Decimal(10, 2)
  /// Shown struck through next to the price; null = no discount.
  originalPrice Decimal?  @db.Decimal(10, 2)
  priceUnit     PriceUnit @default(FIXED)
  durationMin   Int?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([serviceId])
}

/// FAQ entry for a main service (categoryId) or one sub-service (serviceId). A sub-service shows its own first.
model ServiceFaq {
  id         String   @id @default(uuid())
  categoryId String?
  serviceId  String?
  question   String   @db.VarChar(300)
  questionBn String?  @db.VarChar(400)
  answer     String   @db.Text
  answerBn   String?  @db.Text
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  service  Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([serviceId])
}

/// Level 3 of the catalog, the SUB-SERVICE (e.g. "AC Check Up"), shown as a card in the main service's chat.
model Service {
  id           String    @id @default(uuid())
  /// The hidden "Custom" sub-service of a main service: a customer describes the problem, the provider quotes after a visit.
  isCustom     Boolean   @default(false)
  included     String[]  @default([])
  excluded     String[]  @default([])
  details      String?   @db.Text
  categoryId   String
  name         String    @db.VarChar(100)
  // Shown on the public service page (hero image, Bengali title, feature list)
  nameBn       String?   @db.VarChar(150)
  imageUrl     String?   @db.VarChar(500)
  features     String[]  @default([])
  description  String?   @db.VarChar(255)
  isFixedPrice Boolean   @default(false)
  isPopular    Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  orderCount   Int       @default(0)
  basePrice    Decimal   @default(0.0) @db.Decimal(10, 2)
  durationMin  Int?
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  slug         String    @db.VarChar(120)
  /// FIXED = one price; PER_UNIT / PER_SQFT = the customer also picks a quantity.
  priceUnit    PriceUnit @default(FIXED)
  sortOrder    Int       @default(0)
  deletedAt    DateTime?

  category           ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chatSessions       ChatSession[]
  activeChatSlots    ActiveChatSlot[]
  orders             Order[]
  serviceAssignments ServiceAssignee[]
  orderItems         OrderItem[]
  variants           ServiceVariant[]
  faqs               ServiceFaq[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isPopular])
}

model ServiceAssignee {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

model ChatSession {
  id                String          @id @default(uuid())
  customerId        String
  counselorId       String?
  providerId        String?
  customerProfileId String
  serviceId         String
  /// One chat per customer per main service; orders of that service are tabs inside it.
  categoryId        String
  tabCategory       ChatTabCategory @default(SERVICE)
  flowType          ChatFlowType    @default(CUSTOMER_PROVIDER)
  assignedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerUser       User                @relation("ChatSessionCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  counselorUser      User?               @relation("ChatSessionCounselor", fields: [counselorId], references: [id], onDelete: SetNull)
  providerUser       User?               @relation("ChatSessionProvider", fields: [providerId], references: [id], onDelete: SetNull)
  customerProfile    CustomerProfile     @relation("CustomerProfileChatSessions", fields: [customerProfileId], references: [id], onDelete: Cascade)
  service            Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category           ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  participants       ChatParticipant[]
  messages           Message[]
  chatAuditLogs      ChatAuditLog[]
  counselorAuditLogs CounselorAuditLog[]

  @@unique([customerProfileId, categoryId])
  @@index([categoryId])
  @@index([customerId])
  @@index([counselorId])
  @@index([providerId])
  @@index([customerProfileId])
  @@index([serviceId])
}

model ChatParticipant {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  senderId  String
  text      String?     @db.Text
  fileUrl   String?
  type      MessageType @default(TEXT)
  isRead    Boolean     @default(false)
  isSend    Boolean     @default(false)
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  /// null = General Chat tab; otherwise the order tab the message belongs to.
  orderId   String?

  order   Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([senderId])
  @@index([orderId])
}

model ChatAuditLog {
  id             BigInt        @id @default(autoincrement())
  sessionId      String
  senderId       String?
  flowType       AuditFlowType
  messageType    MessageType?
  messagePayload Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User?       @relation("ChatAuditSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([senderId])
}

model ActiveChatSlot {
  id         String         @id @default(uuid())
  providerId String
  customerId String
  serviceId  String
  status     ChatSlotStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([customerId])
  @@index([serviceId])
}

model CustomerRetention {
  id            String   @id @default(uuid())
  providerId    String
  customerId    String
  isChatActive  Boolean  @default(true)
  removedReason String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([providerId, customerId])
  @@index([providerId])
  @@index([customerId])
}

model Order {
  id              String        @id @default(uuid())
  /// Customer-facing reference, e.g. A94K2B. Random, unique, never reused.
  referenceCode   String        @unique @db.VarChar(6)
  completedAt     DateTime?
  /// When a provider first took the order; the customer sees how long that took.
  acceptedAt      DateTime?
  providerId      String
  customerId      String
  technicianId    String?
  serviceId       String
  /// The main service (chat) this order is a tab of. serviceId is its first sub-service.
  categoryId      String?
  /// A customer's custom order: no price until the provider visits and the customer accepts a quote.
  isPricePending  Boolean       @default(false)
  originalPrice   Decimal       @db.Decimal(10, 2)
  adminCommission Decimal       @default(0.0) @db.Decimal(10, 2)
  /// The provider's commission percent when they got the order. Extras and quotes on this order use it,
  /// so an admin changing the provider's rate later does not change a running order.
  commissionRate  Decimal       @default(10.0) @db.Decimal(5, 2)
  additionalPrice Decimal       @default(0.0) @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  priceEditCount  Int           @default(0)
  /// Who created the order: the customer in the app, a provider for their own customer, or staff for a
  /// customer. Orders made before this was recorded are all CUSTOMER.
  createdByRole   OrderCreator  @default(CUSTOMER)
  /// The account that created it (the customer, the provider or the staff member). Null on old orders.
  createdById     String?
  advancePaid     Decimal       @default(0.0) @db.Decimal(10, 2)
  dueAmount       Decimal       @default(0.0) @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(UNPAID)
  orderStatus     OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  provider        ProviderProfile       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  customer        CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician      TechnicianProfile?    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  /// The account that created the order, for its "created by" tag.
  createdBy       User?                 @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  service         Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  category        ServiceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quotes          OrderQuote[]
  paymentAndTip   OrderPaymentAndTip?
  revisions       ServiceRevision[]
  expenseClaims   OrderExpenseClaim[]
  providerReview  ProviderReview?
  bookingDetail   OrderBookingDetail?
  items           OrderItem[]
  messages        Message[]
  extraCharges    ExtraChargeRequest[]
  customerRating  CustomerRating?
  advancePayments OrderAdvancePayment[]
  offers          OrderOffer[]
  assignmentLog   OrderAssignmentLog[]
  walletCredits   WalletCredit[]

  @@index([providerId])
  @@index([customerId])
  @@index([technicianId])
  @@index([serviceId])
  @@index([categoryId])
  @@index([createdById])
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  /// The provider sent a newer quote before the customer answered.
  REPLACED
}

/// The provider's price for a custom order, sent after the site visit. Accepting it sets the order's price.
model OrderQuote {
  id            String      @id @default(uuid())
  orderId       String
  requestedById String
  /// [{ label, amount }] frozen when sent.
  items         Json
  totalAmount   Decimal     @db.Decimal(10, 2)
  note          String?     @db.VarChar(500)
  status        QuoteStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("OrderQuoteRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model OrderPaymentAndTip {
  id                   String             @id @default(uuid())
  orderId              String             @unique
  paymentMode          PaymentMode
  serviceAmountPaid    Decimal            @default(0.0) @db.Decimal(10, 2)
  tipAmount            Decimal            @default(0.0) @db.Decimal(10, 2)
  hasTip               Boolean            @default(false)
  confirmationStatus   ConfirmationStatus @default(PENDING)
  confirmationDeadline DateTime?
  customerConfirmedAt  DateTime?
  disputeReason        String?            @db.Text
  varianceFlag         Boolean            @default(false)
  isGuestOrder         Boolean            @default(false)
  completedByPartner   Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ServiceRevision {
  id                String         @id @default(uuid())
  orderId           String
  issueDescription  String         @db.Text
  attachedImages    String[]
  revisionStatus    RevisionStatus @default(REQUESTED)
  warrantyExpiresAt DateTime?
  /// Written by the provider / technician when finishing: why the order came back after completion.
  completionReason  String?        @db.Text
  /// The provider's own answer: was the first job's quality the cause of this revision?
  wasQualityIssue   Boolean?
  /// When the revision was finished (and settled, if extra charges were added during it).
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ProviderReview {
  id                   String           @id @default(uuid())
  orderId              String           @unique
  providerId           String
  customerId           String
  customerRating       Int
  providerRating       Int?
  reviewComment        String?          @db.Text
  continueWithProvider Boolean          @default(false)
  isPublic             Boolean          @default(true)
  moderationStatus     ModerationStatus @default(PENDING)
  status               UserStatus       @default(ACTIVE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([customerId])
}

model CounselorAuditLog {
  id          String              @id @default(uuid())
  counselorId String
  sessionId   String
  actionType  CounselorActionType
  remarks     String?             @db.VarChar(255)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  counselor CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  session   ChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([counselorId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Place-order catalog. Admins set every price and every "countable" flag here;
// the customer app only displays them and the backend computes the total.
// ---------------------------------------------------------------------------

/// Follow-up question shown after the customer picks a sub-service of this main service
/// (e.g. AC: "Is the outdoor unit hanging?"). Admins set the option prices.
model ServiceQuestion {
  id         String   @id @default(uuid())
  categoryId String
  text       String   @db.VarChar(255)
  textBn     String?  @db.VarChar(300)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ServiceCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  ServiceQuestionOption[]

  @@index([categoryId])
}

model ServiceQuestionOption {
  id          String  @id @default(uuid())
  questionId  String
  label       String  @db.VarChar(100)
  labelBn     String? @db.VarChar(150)
  /// Surcharge per counted unit; 0 for a plain "No".
  unitPrice   Decimal @default(0.0) @db.Decimal(10, 2)
  /// When true the customer says how many of the ordered units this applies to.
  isCountable Boolean @default(false)
  sortOrder   Int     @default(0)

  question ServiceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/// What the customer asked for, plus the price breakdown frozen at order time.
model OrderBookingDetail {
  id                String   @id @default(uuid())
  orderId           String   @unique
  subServiceId      String?
  subServiceName    String   @db.VarChar(200)
  /// Set only on an admin's custom order: the main service the admin typed (subServiceName holds the typed
  /// sub-service). Such an order hangs off the hidden custom service (order-placement/custom-service.ts).
  customServiceName String?  @db.VarChar(100)
  quantity          Int      @default(1)
  description       String?  @db.Text
  districtId        Int
  upazilaId         Int
  addressDetail     String   @db.VarChar(300)
  scheduledDate     DateTime @db.Date
  timeSlot          String   @db.VarChar(40)
  imageUrls         String[] @default([])
  /// [{ label, unitPrice, count, amount }] so later admin price edits never rewrite old orders.
  priceBreakdown    Json
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PriceUnit {
  FIXED
  PER_SQFT
  PER_UNIT
}

/// One priced line of an order: a sub-service, how many, and the price frozen at order time.
model OrderItem {
  id                  String    @id @default(uuid())
  orderId             String
  subServiceId        String
  nameSnapshot        String    @db.VarChar(100)
  unitPriceSnapshot   Decimal   @db.Decimal(10, 2)
  priceUnitSnapshot   PriceUnit @default(FIXED)
  quantity            Int       @default(1)
  lineTotal           Decimal   @db.Decimal(10, 2)
  durationSnapshot    Int?
  /// The variant the customer picked (null for orders placed before variants, and for custom orders).
  variantId           String?
  variantNameSnapshot String?   @db.VarChar(100)
  createdAt           DateTime  @default(now())

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subService Service         @relation(fields: [subServiceId], references: [id])
  variant    ServiceVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([subServiceId])
  @@index([variantId])
}

enum ExtraChargeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Extra work found on site. Sits outside the order price until the customer approves it.
model ExtraChargeRequest {
  id             String            @id @default(uuid())
  orderId        String
  requestedById  String
  /// [{ label, amount }] frozen at request time.
  items          Json
  totalAmount    Decimal           @db.Decimal(10, 2)
  /// Order total when the request was made, so the card can show "previous + new = new total".
  previousTotal  Decimal           @db.Decimal(10, 2)
  status         ExtraChargeStatus @default(PENDING)
  respondedAt    DateTime?
  /// Set when the customer has never signed in to the app (e.g. an order an admin placed for them):
  /// still unanswered at this time, the request is approved automatically. Null = the customer answers.
  autoApproveAt  DateTime?
  /// True when the approval came from that timer, not from the customer.
  isAutoApproved Boolean           @default(false)
  createdAt      DateTime          @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ExtraChargeRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, autoApproveAt])
}

/// The provider's rating of the customer once an order is done. One per order, never edited.
model CustomerRating {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String
  ratedById  String
  rating     Int
  comment    String?  @db.VarChar(300)
  createdAt  DateTime @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Money the customer paid before the final settlement (before the work starts or in the middle of it).
/// The final payment is the order's due, so these amounts are already subtracted from it.
model OrderAdvancePayment {
  id             String      @id @default(uuid())
  orderId        String
  amount         Decimal     @db.Decimal(10, 2)
  method         PaymentMode
  transactionId  String
  /// The bill and what was still due right after this payment, so the receipt stays true if the bill changes later.
  totalAtPayment Decimal?    @db.Decimal(10, 2)
  dueAfter       Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

/// A new order offered to one provider. Several providers are offered the same order at once (a "wave");
/// the first to accept gets it and the rest are withdrawn. A wave nobody answers in time is followed by the next.
model OrderOffer {
  id          String      @id @default(uuid())
  orderId     String
  providerId  String
  wave        Int
  status      OfferStatus @default(OFFERED)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([orderId, providerId])
  @@index([orderId, status])
  @@index([providerId, status])
}

/// The one direct chat between the platform staff (admin, manager, support) and a provider or a customer.
/// Staff share it, so any of them continues the same history. Unlike ChatSession it needs no service or order.
model SupportThread {
  id               String    @id @default(uuid())
  memberId         String    @unique
  /// Messages the member wrote after this moment are unread for staff, and the other way round.
  lastStaffReadAt  DateTime?
  lastMemberReadAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  member   User             @relation("SupportThreadMember", fields: [memberId], references: [id], onDelete: Cascade)
  messages SupportMessage[]
}

model SupportMessage {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  text      String   @db.Text
  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId])
}

/// An upazila where a provider takes orders. A new order is offered to the providers who cover its service
/// upazila first, then to those who cover its district. A provider with no area is offered nothing.
model ProviderServiceArea {
  id         String   @id @default(uuid())
  providerId String
  districtId Int
  upazilaId  Int
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, upazilaId])
  @@index([upazilaId])
  @@index([districtId])
}

/// Who restricted, blocked or banned whom, when and why. Never edited, only appended.
model UserModerationLog {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  action    String   @db.VarChar(20)
  reason    String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  user  User @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// An admin sent a not-yet-accepted order to one provider: OFFER (they may accept or decline) or ASSIGN (theirs at once).
model OrderAssignmentLog {
  id         String   @id @default(uuid())
  orderId    String
  actorId    String
  providerId String
  mode       String   @db.VarChar(10)
  createdAt  DateTime @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor    User            @relation("OrderAssignmentActor", fields: [actorId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// A claim moves between hands until an admin approves it:
/// technician sends → PROVIDER_REVIEW → provider accepts (amounts may change) → PENDING (admin)
/// provider returns it → RETURNED_TO_TECHNICIAN → technician changes it and sends again → PROVIDER_REVIEW
/// admin returns it → PROVIDER_REVIEW again (with the admin's suggested amounts), for the provider to fix.
/// REJECTED: only claims from before this flow (an admin rejection used to end the claim).
enum ExpenseClaimStatus {
  PENDING
  APPROVED
  REJECTED
  PROVIDER_REVIEW
  RETURNED_TO_TECHNICIAN
}

/// What the provider / technician spent on a finished job (parts bought, other costs). An admin reviews it,
/// may change the amounts, and on approval the platform commission is worked out on (total - approved costs).
model OrderExpenseClaim {
  id               String             @id @default(uuid())
  orderId          String
  submittedById    String
  /// [{ label, amount }]: the amounts as they stand now (the last person to change them). The original and every
  /// change are in `history`.
  items            Json
  claimedTotal     Decimal            @db.Decimal(10, 2)
  /// Sent by the order's technician: it goes to the provider first, and the provider may send it back to them.
  isFromTechnician Boolean            @default(false)
  /// Every step: [{ action, byId, byRole, items, total, note, at }], oldest first. Empty on older claims.
  history          Json               @default("[]")
  /// The provider's last note (to the technician when sending it back, or to the admin when accepting).
  providerNote     String?            @db.VarChar(300)
  /// [{ label, amount }] after the admin review; set on approval.
  approvedItems    Json?
  approvedTotal    Decimal?           @db.Decimal(10, 2)
  status           ExpenseClaimStatus @default(PENDING)
  reviewNote       String?            @db.VarChar(300)
  reviewedById     String?
  reviewedAt       DateTime?
  /// The order commission before and after the approval, kept for the record.
  commissionBefore Decimal?           @db.Decimal(10, 2)
  commissionAfter  Decimal?           @db.Decimal(10, 2)
  createdAt        DateTime           @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedBy User  @relation("ExpenseClaimSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ExpenseClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

enum PayoutMethod {
  BKASH
  NAGAD
  BANK
}

enum WithdrawalStatus {
  /// Waiting for an admin; the amount is already held out of the wallet.
  PENDING
  /// An admin sent the money (transactionRef says where).
  PAID
  /// An admin turned it down; the amount went back to the wallet.
  REJECTED
  /// The provider took it back; the amount went back to the wallet.
  CANCELLED
}

/// The provider's share of online money for one settlement of an order (online advance, online payment and
/// online tip, minus the commission). It is in the wallet at once but can only be withdrawn from availableAt
/// (the clearance period), like "pending clearance" on Fiverr.
model WalletCredit {
  id          String   @id @default(uuid())
  providerId  String
  orderId     String
  amount      Decimal  @db.Decimal(10, 2)
  availableAt DateTime
  createdAt   DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerId, availableAt])
  @@index([orderId])
}

/// A provider asks for money in their wallet to be sent to bKash, Nagad or a bank account. An admin pays it
/// outside the app and marks it paid, or rejects it.
model WithdrawalRequest {
  id             String           @id @default(uuid())
  providerId     String
  amount         Decimal          @db.Decimal(10, 2)
  method         PayoutMethod
  accountNumber  String           @db.VarChar(40)
  accountName    String           @db.VarChar(100)
  /// BANK only.
  bankName       String?          @db.VarChar(100)
  branchName     String?          @db.VarChar(100)
  status         WithdrawalStatus @default(PENDING)
  /// The bKash / Nagad / bank transaction id the admin sent the money with.
  transactionRef String?          @db.VarChar(100)
  /// Why it was rejected, or a note on the payment.
  reviewNote     String?          @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status, createdAt])
}

/// A reminder to a provider to clear their due (the cash jobs' commission they owe). Sent into their support chat
/// and live to their open app, by staff or by the daily automatic run.
model DueReminder {
  id          String   @id @default(uuid())
  providerId  String
  /// The due when the reminder went out.
  amount      Decimal  @db.Decimal(10, 2)
  message     String   @db.Text
  /// null = the daily automatic run.
  sentById    String?
  isAutomatic Boolean  @default(false)
  createdAt   DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
}

/// What one provider level needs (Level 1, Level 2, Top Rated; Level 0 needs nothing). An admin edits these;
/// the monthly evaluation and every Level page read them. Meanings in provider-leveling/level-rules.ts.
model LevelSetting {
  level         ProviderLevel @id
  successScore  Decimal       @db.Decimal(3, 1)
  rating        Decimal       @db.Decimal(3, 2)
  responseRate  Int
  orders        Int
  uniqueClients Int
  /// Net earnings in taka.
  earnings      Int
  updatedAt     DateTime      @updatedAt
  updatedById   String?
}

/// Platform-wide settings an admin controls. One row only, id "default"; missing means the defaults below.
model PlatformSetting {
  id                         String   @id @default("default")
  /// Whether the platform takes a charge on orders a provider creates for their own customer.
  providerOrderChargeEnabled Boolean  @default(true)
  /// That charge, in percent (10 = 10%). Ignored while the charge is off.
  providerOrderChargeRate    Decimal  @default(10.0) @db.Decimal(5, 2)
  updatedAt                  DateTime @updatedAt
  updatedById                String?
}

/// How new orders are shared out among providers. One row only, id "default". Off: the old order (rating, then
/// completed orders). On: each provider's dispatch score, made of the factors below, each counted as much as its
/// weight (0 = left out, 10 = counts the most). Meanings in order-dispatch/ranking-rules.ts.
model DispatchSetting {
  id             String   @id @default("default")
  isEnabled      Boolean  @default(false)
  responseRate   Int      @default(8)
  responseSpeed  Int      @default(5)
  successScore   Int      @default(8)
  rating         Int      @default(6)
  behaviour      Int      @default(7)
  level          Int      @default(4)
  experience     Int      @default(3)
  workload       Int      @default(5)
  newcomer       Int      @default(3)
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

/// A provider's numbers for the dispatch score, worked out every 15 minutes so placing an order stays fast.
/// null = no data yet (no offer, no finished order); the score then counts that factor as middling.
model ProviderDispatchStats {
  providerId         String        @id
  responseRate       Int?
  /// Average seconds from an offer to the provider's answer (accept or decline), last 60 days.
  avgResponseSeconds Int?
  successScore       Decimal?      @db.Decimal(3, 1)
  /// Public review average; null before the first review.
  rating             Decimal?      @db.Decimal(3, 2)
  /// 0-100: dues paid on time. Lower for a negative wallet now and for due reminders in the last 60 days.
  behaviour          Int           @default(100)
  level              ProviderLevel @default(LEVEL_0)
  completedOrders    Int           @default(0)
  activeOrders       Int           @default(0)
  refreshedAt        DateTime      @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

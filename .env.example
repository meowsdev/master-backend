DATABASE_URL=postgresql://user:password@localhost:5432/master
PORT=4500
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN_DAYS=365
REFRESH_GRACE_PERIOD_SECONDS=30
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- OTP ---
OTP_EXPIRES_IN_SECONDS=180
# After an OTP is sent to a number, no new one can be sent for this long.
OTP_RESEND_COOLDOWN_SECONDS=300
OTP_MAX_SENDS_PER_DAY=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_IP_MAX_SENDS_PER_HOUR=20
# DEV ONLY: also return the plaintext code in the API response.
# Never enable in production.
OTP_EXPOSE_CODE=false
# DEV ONLY: the code is printed in the backend terminal whenever NODE_ENV is not
# "production" (no SMS provider is wired up yet). Set to false to silence it.
OTP_LOG_TO_CONSOLE=true

# Public address of this API, used to build links to uploaded pictures (e.g. https://api.example.com). Needed behind a proxy / load balancer.
PUBLIC_API_URL=

# New orders are offered to this many providers at once, and each offer lasts this long before the next group is asked.
DISPATCH_PROVIDERS_PER_WAVE=5
DISPATCH_OFFER_SECONDS=90
